+.assignment-preview-modal {
+  width: 656px;
+  max-width: min(88vw, 656px);
+  padding: 0;
+  border-radius: 18px;
+  overflow: hidden;
+  box-shadow: 0 28px 70px rgba(15, 23, 42, 0.22);
+  max-height: calc(100vh - 72px);
+  overflow-y: auto;
+
+  .modal-header-band {
+    display: flex;
+    align-items: flex-start;
+    gap: 14px;
+    padding: 14px 18px 13px;
+    color: #fff;
+    background: linear-gradient(135deg, #173b6f 0%, #1a5e8a 100%);
+  }
+
+  .modal-header-icon {
+    width: 38px;
+    height: 38px;
+    border-radius: 12px;
+    display: grid;
+    place-items: center;
+    background: rgba(255, 255, 255, 0.16);
+    font-size: 18px;
+    flex: 0 0 auto;
+  }
+
+  .modal-title {
+    text-align: left;
+    margin: 0 0 4px;
+    font-size: 1.24rem;
+  }
+
+  .modal-subtitle {
+    margin: 0;
+    color: rgba(255, 255, 255, 0.88);
+    font-size: 0.82rem;
+    line-height: 1.45;
+  }
+
+  .preview-body {
+    padding: 16px 18px 15px;
+    background: #f8fbff;
+  }
+
+  .preview-summary-grid {
+    display: grid;
+    grid-template-columns: repeat(2, minmax(0, 1fr));
+    gap: 12px;
+    margin-bottom: 14px;
+  }
+
+  .preview-field {
+    padding: 11px 13px;
+    border: 1px solid #d9e4f2;
+    border-radius: 12px;
+    background: #fff;
+    color: #274466;
+    line-height: 1.5;
+  }
+
+  .preview-field-full {
+    grid-column: 1 / -1;
+  }
+
+  .preview-section {
+    margin-top: 14px;
+    padding: 13px;
+    border: 1px solid #d9e4f2;
+    border-radius: 14px;
+    background: #fff;
+  }
+
+  .preview-section-title {
+    margin-bottom: 12px;
+    font-size: 0.9rem;
+    font-weight: 800;
+    letter-spacing: 0.04em;
+    text-transform: uppercase;
+    color: #365784;
+  }
+
+  .preview-form-grid {
+    gap: 12px;
+  }
+
+  label {
+    margin-top: 0;
+    margin-bottom: 6px;
+    font-size: 0.72rem;
+    font-weight: 800;
+    letter-spacing: 0.08em;
+    text-transform: uppercase;
+    color: #4b648b;
+  }
+
+  input,
+  select,
+  textarea {
+    margin-top: 0;
+    min-height: 36px;
+    padding: 9px 12px;
+    border: 1px solid #c7d3e4;
+    border-radius: 10px;
+    background: #fff;
+    color: #183153;
+    box-shadow: inset 0 1px 2px rgba(15, 23, 42, 0.03);
+  }
+
+  textarea {
+    min-height: 82px;
+  }
+
+  input:focus,
+  select:focus,
+  textarea:focus {
+    outline: none;
+    border-color: #4f8cff;
+    box-shadow: 0 0 0 3px rgba(79, 140, 255, 0.12);
+  }
+
+  .preview-file-list,
+  .audit-log-list-plain {
+    list-style: none;
+    margin: 0;
+    padding: 0;
+  }
+
+  .preview-file-list li,
+  .audit-log-list-plain li {
+    display: flex;
+    justify-content: space-between;
+    gap: 12px;
+    padding: 10px 0;
+    border-bottom: 1px dashed #d8dfeb;
+  }
+
+  .preview-file-list li:last-child,
+  .audit-log-list-plain li:last-child {
+    border-bottom: 0;
+    padding-bottom: 0;
+  }
+
+  .preview-file-meta {
+    display: flex;
+    flex-direction: column;
+    gap: 4px;
+    color: #48617f;
+  }
+
+  .preview-file-meta strong {
+    color: #234166;
+  }
+
+  .download-btn {
+    border: 1px solid #b9c9de;
+    background: #eef4ff;
+    color: #234e8a;
+    border-radius: 10px;
+    padding: 0.55rem 0.85rem;
+    font-weight: 700;
+    cursor: pointer;
+    height: fit-content;
+  }
+
+  .download-btn:hover {
+    background: #dfebff;
+  }
+
+  .audit-log-panel {
+    max-height: 180px;
+    overflow-y: auto;
+    padding-right: 4px;
+  }
+
+  .empty-state {
+    margin: 0;
+    color: #617a98;
+  }
+
+  .required-indicator {
+    color: #d11f48;
+  }
+
+  .modal-actions {
+    display: flex;
+    justify-content: flex-end;
+    gap: 10px;
+    margin-top: 16px;
+  }
+
+  .submit-btn,
+  .cancel-btn {
+    margin-top: 0;
+    min-width: 112px;
+    padding: 0.64rem 0.9rem;
+    border-radius: 12px;
+    border: none;
+    font-weight: 700;
+    cursor: pointer;
+  }
+
+  .submit-btn {
+    background: #2563eb;
+    color: #fff;
+  }
+
+  .cancel-btn {
+    background: #eef3f9;
+    color: #3b526f;
+    border: 1px solid #d2ddea;
+  }
+
+  @media (max-width: 720px) {
+    .preview-summary-grid,
+    .preview-form-grid {
+      grid-template-columns: 1fr;
+    }
+
+    .preview-file-list li,
+    .audit-log-list-plain li {
+      flex-direction: column;
+    }
+
+    .modal-actions {
+      flex-direction: column-reverse;
+    }
+
+    .submit-btn,
+    .cancel-btn,
+    .download-btn {
+      width: 100%;
+    }
+  }
+}
+
 
 
 
